// Data model: users/{uid}/items/{itemId}, private to uid in Firebase Auth.
// Required fields: type, title (1-80 chars), date (YYYY-MM-DD), time/endTime
// (HH:MM or empty), priority/category enums, tags (<=10 strings of <=30 chars),
// reminder/done, note (<=2,000 chars), createdAt (immutable), updatedAt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Daymark stores each signed-in user's items under users/{uid}/items/{itemId}.
    // There are no public records or shared-workspace records.
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }
    function validTime(value) {
      return value is string && value.size() <= 5 &&
        (value == '' || value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function validTag(value) {
      return value is string && value.size() <= 30;
    }
    function validTags(tags) {
      return tags is list && tags.size() <= 10 &&
        (tags.size() < 1 || validTag(tags[0])) &&
        (tags.size() < 2 || validTag(tags[1])) &&
        (tags.size() < 3 || validTag(tags[2])) &&
        (tags.size() < 4 || validTag(tags[3])) &&
        (tags.size() < 5 || validTag(tags[4])) &&
        (tags.size() < 6 || validTag(tags[5])) &&
        (tags.size() < 7 || validTag(tags[6])) &&
        (tags.size() < 8 || validTag(tags[7])) &&
        (tags.size() < 9 || validTag(tags[8])) &&
        (tags.size() < 10 || validTag(tags[9]));
    }
    function isValidItem(data) {
      return hasRequiredFields(data, [
          'type', 'title', 'date', 'time', 'endTime', 'priority',
          'category', 'tags', 'reminder', 'done', 'note',
          'createdAt', 'updatedAt'
        ]) &&
        hasOnlyAllowedFields(data, [
          'type', 'title', 'date', 'time', 'endTime', 'priority',
          'category', 'tags', 'reminder', 'done', 'note',
          'createdAt', 'updatedAt'
        ]) &&
        data.type in ['task', 'event'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        validTime(data.time) && validTime(data.endTime) &&
        (data.type != 'event' || data.time.size() > 0) &&
        data.priority in ['high', 'medium', 'low'] &&
        data.category in ['工作', '個人', '學習', '健康', '其他'] &&
        validTags(data.tags) &&
        data.reminder is bool && data.done is bool &&
        data.note is string && data.note.size() <= 2000 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() &&
        isValidItem(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && uidNotModified() &&
        isValidItem(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }
    // Deny all collections and documents not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

